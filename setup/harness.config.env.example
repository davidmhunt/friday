# Example harness.config.env — written by init_harness.py, kept at the
# consumer repo root, gitignored (regenerable, environment-specific).
# Secrets (GITLAB_TOKEN, ANTHROPIC_API_KEY, etc.) belong in .env, not here.

PROJECT_NAME=MyProject
PROJECT_NAME_LOWER=myproject
PROJECT_WORKING_ROOT=/home/you/Documents/myproject
PACKAGE_MANAGER=uv
PACKAGE_MANAGER_SYNC_CMD=uv sync
PACKAGE_MANAGER_RUN_CMD=uv run
PACKAGE_MANAGER_ADD_CMD=uv add
TEST_CMD=uv run pytest
DEPENDENCY_MANIFEST=pyproject.toml
LOCKFILE=uv.lock
LAUNCH_METHOD=systemd-run-user
VCS_REMOTE=git@github.com:you/myproject.git
TRACKER_KIND=none
ADAPTERS_ENABLED=claude,antigravity
HIGH_TIER_MODEL_KEYWORDS=opus
BIBLIO_CONTACT_EMAIL=
BIBLIO_USER_AGENT_TOKEN=myproject-biblio-tools
ACCELERATORS_ENABLED=false
DOCKER_ENABLED=false
