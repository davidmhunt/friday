# This file lives in docker/, alongside every other Docker input, so the whole
# container surface is one directory rather than two files at the repo root.
# Two consequences worth knowing:
#
#   * Every relative path below resolves against THIS file's directory, not the
#     repo root — hence the `..` in `context:` and the bind mount. The build
#     context is still the repo root, because the Dockerfile does
#     `COPY docker/entrypoint.sh`, and .dockerignore is read from the context
#     root (so it stays at the repo root, where init_harness.py materializes it).
#   * Compose reads `.env` from the project directory, which defaults to this
#     file's directory — NOT the repo root. A root-only .env would therefore be
#     ignored and `${USER_UID}` would silently fall back to 1000, breaking
#     bind-mount ownership for anyone whose UID isn't 1000. init_harness.py
#     symlinks docker/.env -> ../.env so the root .env is found either way,
#     whether you run from the repo root or from inside docker/.
#
# This is the PROJECT-owned base file — builds the `dev` Dockerfile stage
# (no agent CLIs), so it works standalone for a teammate who cloned the repo
# WITHOUT the .friday/ harness submodule. docker/docker-compose.harness.yml
# is a tier "tooling" (gitignored) override that layers the `harness` stage
# on top when the submodule IS present — see that file's header for how the
# two stack together. Nothing in this file may depend on anything the
# harness override provides: this file must always be a complete, working
# subset on its own.
#
# Pin the compose project name rather than inheriting it from the directory
# basename. Named volumes and the container name are all prefixed with it, so
# two checkouts whose directories happen to share a basename would otherwise
# share one set of auth/cache volumes. This also keeps the prefix consistent
# with the `image:` tag below, which is derived from the same config key.
name: [SET AT SETUP: PROJECT_NAME_LOWER]

services:
  harness:
    build:
      context: ..
      dockerfile: docker/Dockerfile
      # Builds the project-only stage. docker-compose.harness.yml overrides
      # this to `harness` when the tooling submodule is present.
      target: dev
      args:
        USER_UID: "${USER_UID:-1000}"
        USER_GID: "${USER_GID:-1000}"
    image: [SET AT SETUP: PROJECT_NAME_LOWER]-dev:latest
    # The repo is mounted at /<project name>, not a generic /workspace, so the
    # path inside the container matches the project it holds. Derived from the
    # same config key as `name:` and `image:` above, so it stays correct for
    # whatever project this harness is generated into.
    working_dir: /[SET AT SETUP: PROJECT_NAME_LOWER]
    volumes:
      - ..:/[SET AT SETUP: PROJECT_NAME_LOWER]
      - ${SSH_AUTH_SOCK:-/dev/null}:/ssh-agent
      - ~/.gitconfig:/home/agent/.gitconfig:ro
      - herdr-config:/home/agent/.config/herdr
      - agent-cache:/home/agent/.cache
      # --- user-added volumes (managed by init_harness.py) ---
      # --- end user-added volumes ---
      # --- Future device/port passthrough placeholder -----------------------
      # Not needed today. If a future need requires e.g. a USB/serial device
      # inside the container, add here:
      #   devices:
      #     - "/dev/ttyUSB0:/dev/ttyUSB0"
      # and/or a top-level `ports:` block for network passthrough.
      # ------------------------------------------------------------------------
    environment:
      - SSH_AUTH_SOCK=/ssh-agent
    env_file:
      - path: ../.env
        required: false
    stdin_open: true
    tty: true
    init: true
    # <!-- SECTION:docker_gpu:start -->
    # Requires the NVIDIA Container Toolkit on the host:
    # https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    # <!-- SECTION:docker_gpu:end -->

volumes:
  herdr-config:
  agent-cache:
