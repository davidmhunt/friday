# Pin the compose project name rather than inheriting it from the directory
# basename. Named volumes and the container name are all prefixed with it, so
# two checkouts whose directories happen to share a basename would otherwise
# share one set of auth/cache volumes. This also keeps the prefix consistent
# with the `image:` tag below, which is derived from the same config key.
name: [SET AT SETUP: PROJECT_NAME_LOWER]

services:
  harness:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        USER_UID: "${USER_UID:-1000}"
        USER_GID: "${USER_GID:-1000}"
    image: [SET AT SETUP: PROJECT_NAME_LOWER]-harness:latest
    working_dir: /workspace
    volumes:
      - .:/workspace
      - ${SSH_AUTH_SOCK:-/dev/null}:/ssh-agent
      - ~/.gitconfig:/home/agent/.gitconfig:ro
      # <!-- SECTION:docker_agent_claude_compose:start -->
      - claude-config:/home/agent/.claude
      # <!-- SECTION:docker_agent_claude_compose:end -->
      # <!-- SECTION:docker_agent_antigravity_compose:start -->
      - gemini-config:/home/agent/.gemini
      # <!-- SECTION:docker_agent_antigravity_compose:end -->
      - herdr-config:/home/agent/.config/herdr
      - agent-cache:/home/agent/.cache
      # --- user-added volumes (managed by init_harness.py) ---
      # --- end user-added volumes ---
      # --- Future device/port passthrough placeholder -----------------------
      # Not needed today. If a future need requires e.g. a USB/serial device
      # inside the container, add here:
      #   devices:
      #     - "/dev/ttyUSB0:/dev/ttyUSB0"
      # and/or a top-level `ports:` block for network passthrough.
      # ------------------------------------------------------------------------
    environment:
      - SSH_AUTH_SOCK=/ssh-agent
      # <!-- SECTION:docker_agent_antigravity_compose:start -->
      # Switches .agents/hooks/command_guard.py into container mode: its
      # deny list still applies, but the force-ask prompts are skipped so an
      # agent can run unattended. Only meaningful where that hook is wired,
      # which is the Antigravity adapter. See USER_GUIDE.md §5.
      - ANTIGRAVITY_CONTAINER=1
      - CONTAINER_AUTO_ALLOW=1
      # <!-- SECTION:docker_agent_antigravity_compose:end -->
    env_file:
      - path: .env
        required: false
    stdin_open: true
    tty: true
    init: true
    # <!-- SECTION:docker_gpu:start -->
    # Requires the NVIDIA Container Toolkit on the host:
    # https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    # <!-- SECTION:docker_gpu:end -->

volumes:
  # <!-- SECTION:docker_agent_claude_compose:start -->
  claude-config:
  # <!-- SECTION:docker_agent_claude_compose:end -->
  # <!-- SECTION:docker_agent_antigravity_compose:start -->
  gemini-config:
  # <!-- SECTION:docker_agent_antigravity_compose:end -->
  herdr-config:
  agent-cache:
