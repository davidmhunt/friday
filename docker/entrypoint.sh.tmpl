#!/bin/bash
set -e

# The Dockerfile COPYs docker/antigravity_settings.json into the
# gemini-config volume, but that only seeds the volume the *first* time it's
# created — Docker never re-copies into an existing named volume, so a
# change to the source file has no effect until the volume is recreated.
# Re-sync it from the bind-mounted repo on every start instead, so a plain
# restart picks up config changes. Probed at runtime (source file and target
# dir existence) rather than gated at render time, for the same reason the
# AUTO_LAUNCH_AGENT probe below is: this file has no per-adapter variants to
# keep in sync with ADAPTERS_ENABLED.
if [ -f /workspace/docker/antigravity_settings.json ] \
  && [ -d /home/agent/.gemini/antigravity-cli ]; then
  cp /workspace/docker/antigravity_settings.json \
    /home/agent/.gemini/antigravity-cli/settings.json
fi

# Set AUTO_LAUNCH_AGENT=1 (e.g. in .env) to drop straight into an agent CLI
# instead of a plain shell.
#
# This probes PATH at runtime rather than being gated at render time on
# ADAPTERS_ENABLED, deliberately: a render-time `if/fi` whose body is a
# gated section becomes an empty `if ...; then fi` — a bash syntax error
# that breaks the container's entrypoint outright — whenever no adapter is
# enabled. Probing also means a CLI installed later (by hand, or by a
# reconfigure that adds an adapter) is picked up without re-rendering.
#
# First match wins; the order below is the preference order. Note these are
# BINARY names, not adapter names: the Antigravity adapter's CLI installs as
# `agy` (at /home/agent/.local/bin/agy), and no binary named `antigravity`
# is ever created — probing for the adapter name silently never matches.
if [ "${AUTO_LAUNCH_AGENT:-}" = "1" ]; then
  for cli in claude agy; do
    if command -v "$cli" >/dev/null 2>&1; then
      exec "$cli" "$@"
    fi
  done
  echo "entrypoint: AUTO_LAUNCH_AGENT=1 but no agent CLI found on PATH;" \
       "starting the default command instead." >&2
fi

exec "$@"
