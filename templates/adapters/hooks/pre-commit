#!/usr/bin/env bash
# Warn-only markdown-hygiene pre-commit hook (harness.md rule 8).
#
# Prints WARN lines from check_md_hygiene.py but ALWAYS exits 0 — advisory,
# never a gate.
#
# Install (from repo root):
#   ln -sf ../../.agents/hooks/pre-commit .git/hooks/pre-commit

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$REPO_ROOT" ] || exit 0

PYTHON_BIN="$(command -v python3 || command -v python)"
[ -n "$PYTHON_BIN" ] || exit 0

if [ -f "$REPO_ROOT/.agents/hooks/check_md_hygiene.py" ]; then
  "$PYTHON_BIN" "$REPO_ROOT/.agents/hooks/check_md_hygiene.py"
elif [ -f "$REPO_ROOT/.claude/hooks/check_md_hygiene.py" ]; then
  "$PYTHON_BIN" "$REPO_ROOT/.claude/hooks/check_md_hygiene.py"
fi

exit 0
