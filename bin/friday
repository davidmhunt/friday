#!/usr/bin/env python3
"""friday: directive bookkeeping for the friday plugin. On PATH while the plugin is enabled.

  friday status                     directives in this repo, the active one here, hardware leases
  friday new <loop>                 print the next free directive id for a loop (e.g. core -> core-04)
  friday start <id> [--no-gate]     mark <id> active in this worktree, Status -> running@<host>
  friday verify [<id>]              run the directive's Verify command (default: the active one)
  friday finish <id> [--blocked R]  Status -> done (or blocked: R), clear the active marker
  friday land <id> --base <branch>  push friday/<id> and open its PR (gh), or print why not
  friday release <resource>|--all   free a hardware lease (or all of them)
  friday nodes [--check]            list the fleet registry; --check probes each node over ssh
"""
from __future__ import annotations

import argparse
import shlex
import socket
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import friday_core as fc  # noqa: E402
import friday_fleet as ff  # noqa: E402


def _root() -> Path:
    root = fc.repo_root(Path.cwd())
    if root is None:
        sys.exit("friday: not inside a git repository")
    return root


def _need(root: Path, did: str) -> dict:
    d = fc.read_directive(root, did)
    if d is None:
        sys.exit(f"friday: no directive {fc.DIRECTIVE_DIR / (did + '.md')}")
    return d


def cmd_status(a) -> int:
    root = _root()
    ds = fc.list_directives(root)
    if not ds:
        print(f"no directives in {fc.DIRECTIVE_DIR}/")
    for d in ds:
        print(f"{d['id']:<12} {d['status'][:28]:<28} {d['node'][:18]:<18} {d['title'][:60]}")
    m = fc.read_marker(Path.cwd())
    print(f"\nactive here: {m['id'] if m else 'none'}")
    for lease in fc.list_leases():
        age = int((time.time() - lease["time"]) / 60)
        print(f"lease: {lease['resource']} held by {lease['session'][:8]} on {lease['host']} ({age} min)")
    return 0


def cmd_new(a) -> int:
    print(fc.next_id(_root(), a.loop))
    return 0


def cmd_start(a) -> int:
    root = _root()
    d = _need(root, a.id)
    status = d["status"].lower()
    if not status.startswith(("approved", "running")):
        sys.exit(f"friday: {a.id} is '{d['status']}'; only an approved directive can start (the user approves it)")
    if not d["verify"]:
        sys.exit(f"friday: {a.id} has no Verify: line")
    fc.set_status(root, a.id, f"running@{socket.gethostname()}")
    fc.write_marker(Path.cwd(), {"id": a.id, "started": time.time(), "host": socket.gethostname(),
                                 "gate": not a.no_gate})
    print(f"{a.id} active. Verify: {d['verify']}")
    return 0


def cmd_verify(a) -> int:
    root = _root()
    did = a.id or (fc.read_marker(Path.cwd()) or {}).get("id")
    if not did:
        sys.exit("friday: no directive given and none active here")
    d = _need(root, did)
    print(f"$ {d['verify']}", flush=True)
    return subprocess.run(d["verify"], shell=True, cwd=root).returncode


def cmd_finish(a) -> int:
    root = _root()
    _need(root, a.id)
    fc.set_status(root, a.id, f"blocked: {a.blocked}" if a.blocked else "done")
    m = fc.read_marker(Path.cwd())
    if m and m.get("id") == a.id:
        fc.clear_marker(Path.cwd())
    print(f"{a.id}: {'blocked' if a.blocked else 'done'}")
    return 0


def _run(args: list[str], cwd: Path) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(args, 127, "", str(e))


def _compare_url(remote: str, base: str, head: str) -> str | None:
    import re
    m = re.match(r"^(?:git@github\.com:|https://github\.com/|ssh://git@github\.com/)([^/]+/[^/]+?)(?:\.git)?/?$", remote)
    return f"https://github.com/{m.group(1)}/compare/{base}...{head}?expand=1" if m else None


def cmd_land(a) -> int:
    """Push friday/<id> and open its PR. Deterministic, so the workflow doesn't improvise git.
    Exit 0: PR open (last line `PR: <url>`). 3: push failed. 4: pushed, base not on origin.
    5: pushed, no PR because gh is missing or signed out (last line `COMPARE: <url>`)."""
    import os
    root = _root()
    d = _need(root, a.id)
    head = f"friday/{a.id}"
    if fc.current_branch(root) != head:
        sys.exit(f"friday: land runs on branch {head}, not {fc.current_branch(root)}")
    if _run(["git", "status", "--porcelain", "--untracked-files=no"], root).stdout.strip():
        sys.exit("friday: uncommitted changes to tracked files; commit them first")
    remote = _run(["git", "remote", "get-url", "origin"], root)
    if remote.returncode != 0:
        sys.exit("friday: no 'origin' remote")
    push = _run(["git", "push", "-u", "origin", head], root)
    if push.returncode != 0:
        print(f"push failed:\n{push.stderr.strip()}")
        return 3
    print(f"pushed {head}")
    if _run(["git", "ls-remote", "--exit-code", "--heads", "origin", a.base], root).returncode != 0:
        print(f"PR not opened: base branch '{a.base}' is not on origin. Publish it "
              f"(`git push -u origin {a.base}`), then rerun `friday land {a.id} --base {a.base}`.")
        return 4
    gh = os.environ.get("FRIDAY_GH", "gh")
    compare = _compare_url(remote.stdout.strip(), a.base, head)
    if _run([gh, "auth", "status"], root).returncode != 0:
        print(f"PR not opened: `{gh}` is not installed or not signed in.")
        if compare:
            print(f"COMPARE: {compare}")
        return 5
    existing = _run([gh, "pr", "view", head, "--json", "url", "--jq", ".url"], root)
    if existing.returncode == 0 and existing.stdout.strip():
        print(f"PR: {existing.stdout.strip()}")
        return 0
    pr = _run([gh, "pr", "create", "--base", a.base, "--head", head,
               "--title", f"{a.id}: {d['title'].split(':', 1)[-1].strip()}",
               "--body-file", str(fc.directive_path(root, a.id))], root)
    if pr.returncode != 0:
        print(f"PR not opened: {pr.stderr.strip()}")
        if compare:
            print(f"COMPARE: {compare}")
        return 5
    print(f"PR: {pr.stdout.strip().splitlines()[-1]}")
    return 0


def cmd_release(a) -> int:
    if not a.resource and not a.all:
        sys.exit("friday: name a resource, or --all")
    got = fc.release_leases(resource=None if a.all else a.resource)
    print("released: " + (", ".join(got) if got else "nothing"))
    return 0


def _remote_path(p: str) -> str:
    """Shell word for a remote path; a leading ~ becomes $HOME so it expands on the node."""
    if p == "~":
        return '"$HOME"'
    if p.startswith("~/"):
        return '"$HOME"/' + shlex.quote(p[2:])
    return shlex.quote(p)


_TRUST_PY = """
import json, os, sys
p = os.path.abspath(os.environ["FRIDAY_P"])
try:
    projects = json.load(open(os.path.expanduser("~/.claude.json"))).get("projects", {})
except Exception:
    projects = {}
while True:
    if projects.get(p, {}).get("hasTrustDialogAccepted") is True:
        print("ok"); sys.exit()
    if os.path.dirname(p) == p:
        break
    p = os.path.dirname(p)
print("no")
"""


def probe_script(node) -> str:
    if node.role == "target":
        return "echo FRIDAY_PROBE reach=ok\n"
    repos, plug = _remote_path(node.repos), _remote_path(node.plugin_dir)
    return "\n".join([
        "echo FRIDAY_PROBE reach=ok",
        'v=$(claude --version 2>/dev/null | head -n1); echo "FRIDAY_PROBE claude=${v:-missing}"',
        'for t in tmux git; do command -v $t >/dev/null 2>&1 && echo "FRIDAY_PROBE $t=ok" || echo "FRIDAY_PROBE $t=missing"; done',
        f'[ -e {plug}/.git ] && echo "FRIDAY_PROBE plugin=ok" || echo "FRIDAY_PROBE plugin=missing"',
        "if command -v python3 >/dev/null 2>&1; then",
        f'  t=$(FRIDAY_P={repos} python3 -c {shlex.quote(_TRUST_PY)} 2>/dev/null); echo "FRIDAY_PROBE trust=${{t:-unknown}}"',
        'else echo "FRIDAY_PROBE trust=unknown"; fi',
    ]) + "\n"


def check_node(node) -> tuple:
    """Probe one node. Returns (summary_text, [fix lines]); fixes empty means it passes."""
    argv, stdin = ff.ssh_cmd(node, probe_script(node))
    try:
        r = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=60)
        out, rc = r.stdout, r.returncode
    except (OSError, subprocess.TimeoutExpired) as e:
        out, rc = "", 255
    got = dict(l[len("FRIDAY_PROBE "):].split("=", 1) for l in out.splitlines()
               if l.startswith("FRIDAY_PROBE ") and "=" in l)
    if got.get("reach") != "ok":
        return "unreachable", [f"fix: check that `ssh {node.ssh}` works non-interactively "
                               f"(key auth, tailnet up, host awake)"]
    if node.role == "target":
        return "reachable", []
    fixes = []
    cl = got.get("claude", "missing")
    if cl == "missing":
        fixes.append(f"fix: install Claude Code on {node.name} (claude not on PATH or ~/.local/bin)")
    for t in ("tmux", "git"):
        if got.get(t) != "ok":
            fixes.append(f"fix: install {t} on {node.name}")
    if got.get("plugin") != "ok":
        fixes.append(f"fix: git clone the friday repo to {node.plugin_dir} on {node.name}")
    trust = got.get("trust")
    if trust == "unknown":
        fixes.append(f"fix: install python3 on {node.name} so trust in ~/.claude.json can be read")
    elif trust != "ok":
        fixes.append(f"fix: run `claude` once in {node.repos} on {node.name} and accept the trust prompt")
    summary = (f"reachable, claude {cl}, tmux {got.get('tmux', '?')}, git {got.get('git', '?')}, "
               f"plugin_dir {got.get('plugin', '?')}, trust {trust or '?'}")
    return summary, fixes


def cmd_nodes(a) -> int:
    path = ff.find_nodes_file()
    if path is None:
        print(f"no nodes file found; copy {ff.PLUGIN_ROOT / 'nodes.example.toml'} to "
              f"{ff.PLUGIN_ROOT / 'nodes.toml'} (or ~/.config/friday/nodes.toml) and edit it")
        return 1
    print(f"nodes file: {path}")
    try:
        reg = ff.load_nodes(path)
    except ff.RegistryError as e:
        print(f"friday: {e}")
        return 1
    ok = True
    for n in reg.nodes.values():
        if not a.check:
            print(f"{n.name:<12} {n.role:<7} {n.ssh:<24} {n.runtime:<9} "
                  f"tags={','.join(n.tags) or '-'} repos={n.repos or '-'}")
            continue
        summary, fixes = check_node(n)
        print(f"{n.name:<12} {n.role:<7} {'FAIL' if fixes else 'ok':<5} {summary}")
        for f in fixes:
            print(f"  {f}")
        if fixes and n.role in ("master", "worker"):
            ok = False
    return 0 if ok else 1


def main() -> int:
    p = argparse.ArgumentParser(prog="friday", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status").set_defaults(f=cmd_status)
    s = sub.add_parser("new"); s.add_argument("loop"); s.set_defaults(f=cmd_new)
    s = sub.add_parser("start"); s.add_argument("id"); s.add_argument("--no-gate", action="store_true"); s.set_defaults(f=cmd_start)
    s = sub.add_parser("verify"); s.add_argument("id", nargs="?"); s.set_defaults(f=cmd_verify)
    s = sub.add_parser("finish"); s.add_argument("id"); s.add_argument("--blocked", metavar="REASON"); s.set_defaults(f=cmd_finish)
    s = sub.add_parser("land"); s.add_argument("id"); s.add_argument("--base", required=True); s.set_defaults(f=cmd_land)
    s = sub.add_parser("release"); s.add_argument("resource", nargs="?"); s.add_argument("--all", action="store_true"); s.set_defaults(f=cmd_release)
    s = sub.add_parser("nodes"); s.add_argument("--check", action="store_true"); s.set_defaults(f=cmd_nodes)
    a = p.parse_args()
    return a.f(a)


if __name__ == "__main__":
    sys.exit(main())
